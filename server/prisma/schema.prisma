generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A coach account (Prompt 43). Passwords are stored only as a bcrypt hash.
model Coach {
  id           String   @id @default(cuid())
  name         String
  /// Stored lower-case; one account per email.
  email        String   @unique
  passwordHash String
  /// Prompt 47: session tokens carry this number; a password change or reset raises it, which
  /// ends every session issued before (tokens from before Prompt 47 count as 0).
  sessionVersion Int     @default(0)
  createdAt    DateTime @default(now())

  resetTokens  PasswordResetToken[]
  clients      Client[]
  assignments  Assignment[]
  progressLogs ProgressLog[]
  chatMessages ChatMessage[]
  weeklySummaries WeeklySummary[]
  reviewItems  ReviewItem[]

  @@map("coaches")
}

/// A password-reset link (Prompt 47). Only the SHA-256 hash of the token is stored; it expires after
/// 1 hour and works once (usedAt is set when it is spent).
model PasswordResetToken {
  id        String    @id @default(cuid())
  coachId   String
  coach     Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([coachId])
  @@map("password_reset_tokens")
}

model Client {
  id        String   @id @default(cuid())
  /// Owning coach (FK to Coach). NULL = demo data not yet claimed by a coach (see claimDemoData).
  coachId   String?
  coach     Coach?   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name      String
  goal      String   @default("General fitness")
  age       Int?
  weightKg  Float?
  heightCm  Float?
  /// One of: Beginner, Intermediate, Advanced
  level     String   @default("Beginner")
  focus     String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())

  assignments  Assignment[]
  chatMessages ChatMessage[]
  progressLogs ProgressLog[]
  reviewItems  ReviewItem[]

  @@index([coachId])
  @@map("clients")
}

model Assignment {
  id        String   @id @default(cuid())
  /// Owning coach (FK to Coach). NULL = unclaimed demo data.
  coachId   String?
  coach     Coach?   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientId  String
  /// One of: Workout, Nutrition, Habit, Recovery
  type      String
  title     String
  details   String
  reasoning String   @default("")
  /// One of: ai, manual
  source    String   @default("manual")
  /// One of: Active, Done, Paused
  status    String   @default("Active")
  /// YYYY-MM-DD
  date      String
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([coachId])
  @@map("assignments")
}

model ChatMessage {
  id        String   @id @default(cuid())
  /// Owning coach (FK to Coach). NULL = unclaimed demo data.
  coachId   String?
  coach     Coach?   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientId  String
  /// One of: coach, ai
  role      String
  content   String
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([coachId])
  @@map("chat_messages")
}

model ProgressLog {
  id           String   @id @default(cuid())
  /// Owning coach (FK to Coach). NULL = unclaimed demo data.
  coachId      String?
  coach        Coach?   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientId     String
  /// YYYY-MM-DD
  date         String
  weightKg     Float?
  /// 0-100
  adherence    Int?
  workoutsDone Int?
  note         String   @default("")
  createdAt    DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([coachId])
  @@map("progress_logs")
}

/// One thing waiting for the coach's decision (Prompt 52): an AI suggestion the coach parked, or a
/// new progress log flagged for review. A separate table (not a status on Assignment / ProgressLog)
/// because a parked suggestion is not an assignment yet and must not appear in the planner, and a
/// flagged log must stay exactly as logged. Decided rows are kept forever: history, never deleted.
model ReviewItem {
  id        String   @id @default(cuid())
  coachId   String
  coach     Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// One of: suggestion, checkin
  kind      String
  /// One of: Pending, Approved, Dismissed
  status    String   @default("Pending")
  title     String
  summary   String   @default("")
  /// Suggestions only: the assignment to create on approve (Workout / Nutrition / Habit / Recovery).
  type      String?
  details   String   @default("")
  reasoning String   @default("")
  /// checkin items: the ProgressLog this row is about.
  sourceId  String?
  /// Set when an approved suggestion became a real assignment.
  assignmentId String?
  createdAt DateTime @default(now())
  decidedAt DateTime?

  @@index([coachId, status])
  @@index([clientId])
  @@map("review_items")
}

/// One saved AI weekly summary per coach per week (Prompt 51). `facts` is the exact numbers the
/// summary was written from, kept so every number in `text` can be checked later.
model WeeklySummary {
  id        String   @id @default(cuid())
  coachId   String
  coach     Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  /// Monday of the summarised week, "YYYY-MM-DD" (UTC).
  weekStart String
  text      String
  facts     Json
  createdAt DateTime @default(now())

  @@unique([coachId, weekStart])
  @@map("weekly_summaries")
}

/// Landing page "Start free" sign-ups (Prompt 41). No password, no payment. Not coach-owned.
model Lead {
  id        String   @id @default(cuid())
  name      String
  /// Stored lower-case; one row per email.
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("leads")
}
