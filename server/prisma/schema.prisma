generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A coach account (Prompt 43). Passwords are stored only as a bcrypt hash.
model Coach {
  id           String   @id @default(cuid())
  name         String
  /// Stored lower-case; one account per email.
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  clients      Client[]
  assignments  Assignment[]
  progressLogs ProgressLog[]
  chatMessages ChatMessage[]

  @@map("coaches")
}

model Client {
  id        String   @id @default(cuid())
  /// Owning coach (FK to Coach). NULL = demo data not yet claimed by a coach (see claimDemoData).
  coachId   String?
  coach     Coach?   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name      String
  goal      String   @default("General fitness")
  age       Int?
  weightKg  Float?
  heightCm  Float?
  /// One of: Beginner, Intermediate, Advanced
  level     String   @default("Beginner")
  focus     String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())

  assignments  Assignment[]
  chatMessages ChatMessage[]
  progressLogs ProgressLog[]

  @@index([coachId])
  @@map("clients")
}

model Assignment {
  id        String   @id @default(cuid())
  /// Owning coach (FK to Coach). NULL = unclaimed demo data.
  coachId   String?
  coach     Coach?   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientId  String
  /// One of: Workout, Nutrition, Habit, Recovery
  type      String
  title     String
  details   String
  reasoning String   @default("")
  /// One of: ai, manual
  source    String   @default("manual")
  /// One of: Active, Done, Paused
  status    String   @default("Active")
  /// YYYY-MM-DD
  date      String
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([coachId])
  @@map("assignments")
}

model ChatMessage {
  id        String   @id @default(cuid())
  /// Owning coach (FK to Coach). NULL = unclaimed demo data.
  coachId   String?
  coach     Coach?   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientId  String
  /// One of: coach, ai
  role      String
  content   String
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([coachId])
  @@map("chat_messages")
}

model ProgressLog {
  id           String   @id @default(cuid())
  /// Owning coach (FK to Coach). NULL = unclaimed demo data.
  coachId      String?
  coach        Coach?   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientId     String
  /// YYYY-MM-DD
  date         String
  weightKg     Float?
  /// 0-100
  adherence    Int?
  workoutsDone Int?
  note         String   @default("")
  createdAt    DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([coachId])
  @@map("progress_logs")
}

/// Landing page "Start free" sign-ups (Prompt 41). No password, no payment. Not coach-owned.
model Lead {
  id        String   @id @default(cuid())
  name      String
  /// Stored lower-case; one row per email.
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("leads")
}
