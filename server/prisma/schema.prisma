generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A coach account (Prompt 43). Passwords are stored only as a bcrypt hash.
model Coach {
  id           String   @id @default(cuid())
  name         String
  /// Stored lower-case; one account per email.
  email        String   @unique
  passwordHash String
  /// Prompt 47: session tokens carry this number; a password change or reset raises it, which
  /// ends every session issued before (tokens from before Prompt 47 count as 0).
  sessionVersion Int     @default(0)
  /// Prompt 68: the one currency all of this coach's plan prices and payments are in (ISO code,
  /// "INR" or "USD"). Data never stores a symbol; the UI formats the amount with this code.
  currency     String   @default("INR")
  /// "Continue with Google": the Google account's stable id (OIDC `sub`), set on first Google
  /// sign-in. NULL for coaches who have never used Google. Unique when set.
  googleSub    String?  @unique
  /// Prompt 76: the coach's join code (e.g. ANNA-7K2Q8M), stored upper-case, made on first use.
  /// Clients sign up under this coach with it. A new code replaces the old one at once.
  joinCode     String?  @unique
  /// Prompt 76: false = the code is turned off (the public lookup answers the same 404 as unknown).
  joinCodeActive Boolean @default(true)
  /// Prompt 76: when true, clients who join with the code wait for the coach's approval (Prompt 77/84).
  approveNewClients Boolean @default(false)
  createdAt    DateTime @default(now())

  resetTokens  PasswordResetToken[]
  clients      Client[]
  assignments  Assignment[]
  progressLogs ProgressLog[]
  chatMessages ChatMessage[]
  weeklySummaries WeeklySummary[]
  reviewItems  ReviewItem[]
  dailyCheckIns DailyCheckIn[]
  habits       Habit[]
  measurements Measurement[]
  threadMessages ThreadMessage[]
  clientInvites ClientInvite[]
  clientPlans  ClientPlan[]
  payments     Payment[]
  appointments Appointment[]
  workoutTemplates WorkoutTemplate[]
  meals        Meal[]

  @@map("coaches")
}

/// A client's current paid plan (Prompt 68). RECORD-KEEPING ONLY: nothing here charges anyone.
/// One plan per client: change it by editing, end it with status "Ended" (history stays in Payment).
model ClientPlan {
  id           String   @id @default(cuid())
  coachId      String
  coach        Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientId     String   @unique
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  planName     String
  /// In the coach's currency (Coach.currency). Two decimals at most.
  priceAmount  Float
  /// One of: Monthly, Quarterly, Yearly, One-time
  billingCycle String
  /// YYYY-MM-DD
  startDate    String
  /// YYYY-MM-DD. Moves on by one billing cycle each time a payment is recorded (not for One-time).
  nextDueDate  String
  /// The day of the month payments fall due (1-31). Set from nextDueDate when the plan is created
  /// and whenever the coach sets a due date; a short month clamps to its last day and the next one
  /// returns to this day, so a plan due on the 31st (or 30th, 29th) never drifts to the 28th.
  anchorDay    Int
  /// One of: Active, Paused, Ended
  status       String   @default("Active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  payments Payment[]

  @@index([coachId])
  @@map("client_plans")
}

/// One payment the coach recorded by hand (Prompt 68). No gateway, no automatic charging.
model Payment {
  id           String     @id @default(cuid())
  coachId      String
  coach        Coach      @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientPlanId String
  clientPlan   ClientPlan @relation(fields: [clientPlanId], references: [id], onDelete: Cascade)
  amount       Float
  /// YYYY-MM-DD
  paidOn       String
  /// One of: Cash, UPI, Card, Bank, Other
  method       String
  note         String     @default("")
  createdAt    DateTime   @default(now())

  @@index([clientId, paidOn])
  @@index([coachId])
  @@map("payments")
}

/// Prompt 77: a client's "forgot password" token. Same rules as the coach's PasswordResetToken:
/// only the SHA-256 hash is stored, 1 hour, single use.
model ClientPasswordResetToken {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId])
  @@map("client_password_reset_tokens")
}

/// A single-use invite for a client to set their password (Prompt 65). Only the SHA-256 hash of the
/// token is stored; the raw token exists only in the emailed / copied link. Lives 48 hours.
model ClientInvite {
  id        String    @id @default(cuid())
  coachId   String
  coach     Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// The address this invite was sent to. It becomes Client.loginEmail only when the client sets a
  /// password from this link, so an unused invite never changes how anyone signs in.
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId])
  @@index([coachId])
  @@map("client_invites")
}

/// A password-reset link (Prompt 47). Only the SHA-256 hash of the token is stored; it expires after
/// 1 hour and works once (usedAt is set when it is spent).
model PasswordResetToken {
  id        String    @id @default(cuid())
  coachId   String
  coach     Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([coachId])
  @@map("password_reset_tokens")
}

model Client {
  id        String   @id @default(cuid())
  /// Owning coach (FK to Coach). NULL = demo data not yet claimed by a coach (see claimDemoData).
  coachId   String?
  coach     Coach?   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name      String
  goal      String   @default("General fitness")
  age       Int?
  weightKg  Float?
  heightCm  Float?
  /// One of: Beginner, Intermediate, Advanced
  level     String   @default("Beginner")
  focus     String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  /// Client sign-in (Prompt 65): the email the client signs in with. Set only when the client sets
  /// a password from an invite sent to that address. Unique when set.
  loginEmail    String?  @unique
  /// NULL until the client sets a password from their invite link. Never returned by any API
  /// (the Prisma client omits it globally - see src/db.ts).
  passwordHash  String?
  /// Raised when the client's password is (re)set, ending every older client session.
  clientSessionVersion Int @default(0)
  /// Prompt 77: "active" | "pending" (joined with the code while the coach approves new clients) |
  /// "declined". Pending / declined clients can sign in but every client-data route answers 403.
  joinStatus    String   @default("active")
  /// Prompt 77: how the record started: "coach" (added by the coach) or "code" (joined with the code).
  joinedVia     String   @default("coach")
  /// Prompt 77: the client's display unit for weight, "kg" or "lb". Weights are always stored in kg.
  units         String   @default("kg")
  /// Prompt 77: when the client finished (or skipped) the welcome questions. NULL = not shown yet.
  onboardedAt   DateTime?
  /// Prompt 78: the Google account ("sub") this client signs in with. Separate from Coach.googleSub:
  /// a coach's Google account never signs in as a client, and the other way round.
  googleSub     String?  @unique
  /// Prompt 83: the client's own timezone override (IANA name, e.g. "Asia/Kolkata"); null = the device's.
  timezone      String?
  /// When the client explicitly agreed that their coach and Repsy may store the health details they enter
  /// (weight, height, injuries). Asked separately from sign-up.
  healthConsentAt DateTime?
  /// Prompt 78: the last Google sign-in (Prompt 83 lets a Google-only client delete their account
  /// within 5 minutes of a fresh one).
  lastGoogleAuthAt DateTime?
  /// Prompt 80: the client's daily targets, set by the coach from the macro calculator. NULL = none set.
  calorieTarget  Int?
  proteinTargetG Float?
  /// Prompt 80: the weekday (0 = Sunday ... 6 = Saturday) the client is asked for their weekly check-in.
  weeklyCheckInDay Int @default(0)

  assignments  Assignment[]
  passwordResets ClientPasswordResetToken[]
  chatMessages ChatMessage[]
  progressLogs ProgressLog[]
  reviewItems  ReviewItem[]
  dailyCheckIns DailyCheckIn[]
  habits       Habit[]
  measurements Measurement[]
  threadMessages ThreadMessage[]
  invites      ClientInvite[]
  plan         ClientPlan?
  payments     Payment[]
  appointments Appointment[]

  @@index([coachId])
  @@map("clients")
}

/// A scheduled session, call or review the coach books for a client (Prompt 69). startsAt / endsAt are
/// UTC instants (timestamptz-style: the client converts to and from the viewer's local time).
/// No reminders, no video-call integration, no calendar sync.
model Appointment {
  id        String   @id @default(cuid())
  coachId   String
  coach     Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  /// One of: Session, Call, Check-in review, Other
  type      String
  startsAt  DateTime
  endsAt    DateTime
  /// Optional place or link (text only; nothing is fetched or joined).
  location  String   @default("")
  /// One of: Booked, Done, Cancelled, No-show
  status    String   @default("Booked")
  /// The coach's private note. Never sent to the client.
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([coachId, startsAt])
  @@index([clientId, startsAt])
  @@map("appointments")
}

model Assignment {
  id        String   @id @default(cuid())
  /// Owning coach (FK to Coach). NULL = unclaimed demo data.
  coachId   String?
  coach     Coach?   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientId  String
  /// One of: Workout, Nutrition, Habit, Recovery
  type      String
  title     String
  details   String
  reasoning String   @default("")
  /// One of: ai, manual
  source    String   @default("manual")
  /// One of: Active, Done, Paused
  status    String   @default("Active")
  /// YYYY-MM-DD
  date      String
  createdAt DateTime @default(now())
  /// Prompt 79: when it was marked Done, and by whom ("coach" | "client"). NULL while not done.
  completedAt  DateTime?
  completedBy  String?
  /// Prompt 79: the client's own "how hard was it" (1-10) and note when THEY finished it.
  clientEffort Int?
  clientNote   String   @default("")
  /// Prompt 80: meals from the coach's library attached to a Nutrition plan (the coach's own meals only).
  mealIds      String[] @default([])

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([coachId])
  /// Prompt 84: Home alerts (plans a client finished in the last 24 h).
  @@index([coachId, completedAt])
  @@map("assignments")
}

/// Coach <-> client chat (Prompt 63). NOT the AI Coach chat: that is ChatMessage / chat_messages.
/// Real-time is out of v2 scope; the Messages tab polls every 20 seconds.
model ThreadMessage {
  id        String    @id @default(cuid())
  coachId   String
  coach     Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// One of: coach, client
  sender    String
  body      String
  createdAt DateTime  @default(now())
  /// When the OTHER side read it. Coach-side read = a client message the coach has opened.
  readAt    DateTime?

  @@index([clientId, createdAt])
  @@index([coachId])
  /// Prompt 84: Home alerts count unread client messages per coach every minute.
  @@index([coachId, sender, readAt])
  @@map("thread_messages")
}

model ChatMessage {
  id        String   @id @default(cuid())
  /// Owning coach (FK to Coach). NULL = unclaimed demo data.
  coachId   String?
  coach     Coach?   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientId  String
  /// One of: coach, ai
  role      String
  content   String
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([coachId])
  @@map("chat_messages")
}

model ProgressLog {
  id           String   @id @default(cuid())
  /// Owning coach (FK to Coach). NULL = unclaimed demo data.
  coachId      String?
  coach        Coach?   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientId     String
  /// YYYY-MM-DD
  date         String
  weightKg     Float?
  /// 0-100
  adherence    Int?
  workoutsDone Int?
  note         String   @default("")
  /// Prompt 80: "coach" or "client" (a client's weekly check-in).
  enteredBy    String   @default("coach")
  createdAt    DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([coachId])
  @@map("progress_logs")
}

/// One day's check-in for a client (Prompt 53): how the day went, in the client's own numbers.
/// One row per client per day - saving the same date again updates that row.
/// `sleepHours` and `recoveryScore` are filled in by Prompt 55; they are optional here.
model DailyCheckIn {
  id            String   @id @default(cuid())
  coachId       String
  coach         Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD
  date          String
  /// 1-5
  energy        Int?
  /// 1-5
  mood          Int?
  /// 0-16, one decimal (Prompt 55)
  sleepHours    Float?
  /// 1-5 (Prompt 55)
  recoveryScore Int?
  waterLiters   Float?
  steps         Int?
  foodNote      String   @default("")
  /// Prompt 80: who saved this day: "coach" or "client". A client never overwrites a coach-entered day.
  enteredBy     String   @default("coach")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([clientId, date])
  @@index([coachId])
  @@map("daily_checkins")
}

/// A daily habit the coach tracks for one client (Prompt 54), up to 8 active per client.
/// Archiving sets `active` to false - the habit and its logs are kept as history.
model Habit {
  id        String     @id @default(cuid())
  coachId   String
  coach     Coach      @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())

  logs HabitLog[]

  @@index([clientId, active])
  @@index([coachId])
  @@map("habits")
}

/// One day of one habit (Prompt 54). One row per habit per day; `done` false = ticked off again.
model HabitLog {
  id      String  @id @default(cuid())
  habitId String
  habit   Habit   @relation(fields: [habitId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD
  date    String
  done    Boolean @default(true)
  /// Prompt 80: who ticked it: "coach" or "client". A client never changes a coach's tick.
  enteredBy String @default("coach")

  @@unique([habitId, date])
  @@map("habit_logs")
}

/// One set of body measurements for a client on one date (Prompt 56). Everything except `date` is
/// optional. Weight is NOT stored here: the chart reads it from ProgressLog. Field names are part of
/// the API contract (the CSV export of Prompt 70 reuses them).
model Measurement {
  id             String   @id @default(cuid())
  coachId        String
  coach          Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD
  date           String
  waistCm        Float?
  chestCm        Float?
  armCm          Float?
  hipCm          Float?
  bodyFatPercent Float?
  note           String   @default("")
  /// Prompt 81: "coach" or "client". A client may delete only the measurements they added.
  createdBy      String   @default("coach")
  createdAt      DateTime @default(now())

  @@index([clientId, date])
  @@index([coachId])
  @@map("measurements")
}

/// A coach's reusable workout (Prompt 58). `exercises` is JSON in the Manual Planner's shape, in order:
/// [{ name, sets, reps, rest (seconds) }]. Coach-level: no client, never shared between coaches.
model WorkoutTemplate {
  id        String   @id @default(cuid())
  coachId   String
  coach     Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name      String
  focus     String   @default("")
  exercises Json
  notes     String   @default("")
  createdAt DateTime @default(now())

  @@index([coachId])
  @@map("workout_templates")
}

/// A coach's reusable meal (Prompt 60). `mealType` is Breakfast / Lunch / Dinner / Snack (checked by zod).
/// Every macro value is coach-entered: nothing is fetched or calculated. Coach-level, never shared.
model Meal {
  id          String   @id @default(cuid())
  coachId     String
  coach       Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name        String
  mealType    String
  calories    Int
  proteinG    Float
  carbsG      Float
  fatG        Float
  ingredients String   @default("")
  steps       String   @default("")
  createdAt   DateTime @default(now())

  @@index([coachId])
  @@map("meals")
}

/// One thing waiting for the coach's decision (Prompt 52): an AI suggestion the coach parked, or a
/// new progress log flagged for review. A separate table (not a status on Assignment / ProgressLog)
/// because a parked suggestion is not an assignment yet and must not appear in the planner, and a
/// flagged log must stay exactly as logged. Decided rows are kept forever: history, never deleted.
model ReviewItem {
  id        String   @id @default(cuid())
  coachId   String
  coach     Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// One of: suggestion, checkin
  kind      String
  /// One of: Pending, Approved, Dismissed
  status    String   @default("Pending")
  title     String
  summary   String   @default("")
  /// Suggestions only: the assignment to create on approve (Workout / Nutrition / Habit / Recovery).
  type      String?
  details   String   @default("")
  reasoning String   @default("")
  /// checkin items: the ProgressLog this row is about.
  sourceId  String?
  /// Set when an approved suggestion became a real assignment.
  assignmentId String?
  createdAt DateTime @default(now())
  decidedAt DateTime?

  @@index([coachId, status])
  @@index([clientId])
  @@map("review_items")
}

/// One saved AI weekly summary per coach per week (Prompt 51). `facts` is the exact numbers the
/// summary was written from, kept so every number in `text` can be checked later.
model WeeklySummary {
  id        String   @id @default(cuid())
  coachId   String
  coach     Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  /// Monday of the summarised week, "YYYY-MM-DD" (UTC).
  weekStart String
  text      String
  facts     Json
  createdAt DateTime @default(now())

  @@unique([coachId, weekStart])
  @@map("weekly_summaries")
}

/// Landing page "Start free" sign-ups (Prompt 41). No password, no payment. Not coach-owned.
model Lead {
  id        String   @id @default(cuid())
  name      String
  /// Stored lower-case; one row per email.
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("leads")
}
