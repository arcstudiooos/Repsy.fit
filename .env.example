# PostgreSQL connection string, e.g. postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# Secret key for the AI provider - never commit a real value
AI_API_KEY=
# Base URL of the AI provider's API
AI_BASE_URL=
# AI model name to use for coaching replies
AI_MODEL=
# Secret that signs coach login cookies: a long random string (16+ characters), e.g. from
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`. Required in
# production (sign-in is switched off without it); optional locally.
SESSION_SECRET=
# Password reset email (Prompt 47). Reset links are sent ONLY through this SMTP provider.
# Leave SMTP_HOST / SMTP_FROM empty and, in development, the link is printed on the server console
# (never shown in the app); in production no email is sent and the server logs that setup is missing.
SMTP_HOST=
# 587 (STARTTLS, default) or 465 (set SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown on the email, e.g. Repsy Coach <no-reply@yourdomain.com>
SMTP_FROM=
# Public address of the app, used to build the link in the email, e.g. https://repsy-coach.onrender.com
# (on Render it falls back to RENDER_EXTERNAL_URL; locally to http://localhost:5173)
APP_URL=
# Port the server listens on (Render sets this automatically; local default 3001)
PORT=3001

# ---- Inbound mail forwarding (Nov 2026) ----
# Mail sent to hello@repsy.fit lands in Resend's "Receiving" section. Resend has no forwarding
# setting, so POST /api/inbound/resend answers its email.received webhook and forwards the message.
# Leave these empty and the route answers 503 (nothing else is affected).
# A Resend API key with send access (Resend -> API keys):
RESEND_API_KEY=
# The signing secret of the webhook you created in Resend (starts with whsec_):
RESEND_WEBHOOK_SECRET=
# Where forwarded mail should land, e.g. you@gmail.com:
INBOUND_FORWARD_TO=
# Optional sender for the forwarded copy; must be on a domain verified in Resend.
INBOUND_FORWARD_FROM=Repsy <hello@repsy.fit>

# ---- The coach's subscription (Nov 2026, stage 1) ----
# The paywall is OFF unless this is exactly "true". Leave it off until the checkout flow is live.
BILLING_ENFORCED=false
# PayPal (stage 2). Sandbox first; live keys only after a clean sandbox run.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Plan ids per environment (public: they appear in the checkout).
PAYPAL_PLAN_SOLO=
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_STUDIO=
